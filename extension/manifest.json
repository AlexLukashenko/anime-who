{
  "manifest_version": 3,
  "name": "Кто это? — персонажи аниме",
  "short_name": "Кто это?",
  "description": "Показывает фото и имя персонажа аниме, когда о нём говорят в серии. YummyAnime (все плееры), DreamCast и другие сайты.",
  "version": "0.3.4",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Кто это?",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "ui/options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen",
    "tabCapture",
    "activeTab"
  ],
  "host_permissions": [
    "https://shikimori.io/*",
    "https://shikimori.one/*",
    "https://graphql.anilist.co/*",
    "https://jimaku.cc/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://old.yummyani.me/*",
        "https://yummyani.me/*",
        "https://*.yummyani.me/*",
        "https://yummy-anime.ru/*",
        "https://*.yummy-anime.ru/*",
        "https://dreamerscast.com/*",
        "https://*.dreamerscast.com/*",
        "https://shikimori.io/animes/*",
        "https://shikimori.one/animes/*"
      ],
      "js": [
        "content/top.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/player.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Показать/скрыть панель персонажей"
    },
    "resync": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Подобрать задержку субтитров по звуку"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
